-- THEME APPLICATION
-- ============================================================
local function applyTheme(themeIndex)
    local theme = THEMES[themeIndex]
    if not theme then return end
    currentTheme = themeIndex

    for k, v in pairs(theme) do
        if CONFIG[k] ~= nil and k ~= "name" then
            CONFIG[k] = v
        end
    end

    if not isEnabled then return end

    for _, inst in ipairs(createdInstances) do
        if inst:IsA("Atmosphere") then
            safeSet(inst, "Color", theme.atmosphereColor)
            safeSet(inst, "Decay", theme.atmosphereDecay)
        elseif inst:IsA("BloomEffect") then
            safeSet(inst, "Intensity", theme.bloomIntensity)
        elseif inst:IsA("ColorCorrectionEffect") then
            safeSet(inst, "TintColor", theme.ccTint)
            safeSet(inst, "Saturation", theme.ccSaturation)
        elseif inst:IsA("ParticleEmitter") then
            safeSet(inst, "Color", ColorSequence.new(theme.particleColor))
        end
    end

    safeSet(Lighting, "Ambient", theme.ambient)
    safeSet(Lighting, "OutdoorAmbient", theme.outdoorAmbient)
    safeSet(Lighting, "ColorShift_Top", theme.colorShiftTop)
    safeSet(Lighting, "ColorShift_Bottom", theme.colorShiftBottom)

    local terrain = Workspace:FindFirstChildOfClass("Terrain")
    if terrain then safeSet(terrain, "WaterColor", theme.terrainWaterColor) end

    for _, inst in ipairs(createdInstances) do
        if inst:IsA("Trail") then safeSet(inst, "Color", ColorSequence.new(theme.trailColor)) end
    end
end

