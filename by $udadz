    if not CONFIG.parryBlurEnabled then return end
    local function triggerParryBlur()
        if parryBlurActive then return end
        parryBlurActive = true
        safeSet(blurEffect, "Size", CONFIG.parryBlurSize)
        task.delay(CONFIG.parryBlurDuration, function()
            safeSet(blurEffect, "Size", 0)
            parryBlurActive = false
        end)
    end

    local remoteFolder = Workspace:FindFirstChild("Remotes") or Workspace:FindFirstChild("RemoteEvents")
    if remoteFolder then
        for _, remote in ipairs(remoteFolder:GetChildren()) do
            if remote:IsA("RemoteEvent") then
                local name = remote.Name:lower()
                if name:find("parry") or name:find("hit") or name:find("block") or name:find("clash") then
                    trackConnection(remote.OnClientEvent:Connect(triggerParryBlur))
                end
            end
        end
    end

    if LocalPlayer.Character then
        local humanoid = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
        if humanoid then
            trackConnection(humanoid.HealthChanged:Connect(function(newHealth)
                if newHealth < humanoid.MaxHealth then triggerParryBlur() end
            end))
        end
    end
end

local function startAnimationLoop(atmos, bloom, vignette, chroma)
    local startTime = tick()
    local hueTime = 0

    trackConnection(RunService.RenderStepped:Connect(function(dt)
        if not isEnabled then return end
        local t = tick() - startTime
        hueTime = hueTime + dt * CONFIG.hueRotationSpeed

        if atmos then
            local pulse = math.sin(t * CONFIG.atmospherePulseSpeed) * CONFIG.atmospherePulseAmount
            safeSet(atmos, "Density", math.max(0, CONFIG.atmosphereDensity + pulse))
        end

        if bloom then
            local bpulse = math.sin(t * CONFIG.bloomPulseSpeed) * CONFIG.bloomPulseAmount
            safeSet(bloom, "Intensity", math.max(0, CONFIG.bloomIntensity + bpulse))
        end

        local hue = hueTime % 1
        safeSet(Lighting, "ColorShift_Top", Color3.fromHSV(hue, 1, 1))
        safeSet(Lighting, "ColorShift_Bottom", Color3.fromHSV((hue + 0.5) % 1, 1, 1))

        if vignette then
            local vpulse = math.sin(t * CONFIG.vignettePulseSpeed) * CONFIG.vignettePulseAmount
            safeSet(vignette, "BackgroundTransparency", math.clamp(CONFIG.vignetteTransparency + vpulse, 0, 1))
        end

        if chroma then
            local cpulse = math.sin(t * CONFIG.chromaPulseSpeed) * CONFIG.chromaPulseAmount
            safeSet(chroma, "BackgroundTransparency", math.clamp(CONFIG.chromaTransparency + cpulse, 0, 1))
        end

        scanAccumulator = scanAccumulator + dt
        if scanAccumulator >= CONFIG.descendantScanInterval then
            scanAccumulator = 0
            tuneMaterials()
        end
    end))
end

