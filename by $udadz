local function addParticlesToCharacter(character)
    local hrp = character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    local existing = 0
    for _, child in ipairs(hrp:GetChildren()) do
        if child:IsA("ParticleEmitter") and child.Name == "BladeBallShaderParticles" then existing = existing + 1 end
    end
    if existing >= CONFIG.maxParticlesPerCharacter then return end

    createInstance("ParticleEmitter", hrp, {
        Name = "BladeBallShaderParticles",
        Texture = CONFIG.particleTexture,
        Color = ColorSequence.new(CONFIG.particleColor),
        Size = NumberSequence.new(CONFIG.particleSize),
        Lifetime = NumberSequence.new(CONFIG.particleLifetime),
        Rate = CONFIG.particleRate,
        Speed = NumberRange.new(0.5, 1.5),
        SpreadAngle = Vector2.new(180, 180),
        LightEmission = 1,
        LightInfluence = 0,
        Transparency = NumberSequence.new({
            NumberSequenceKeypoint.new(0, 0),
            NumberSequenceKeypoint.new(0.7, 0.5),
            NumberSequenceKeypoint.new(1, 1),
        }),
    })
end

local function addOrbParticles(orb)
    if not orb:IsA("BasePart") then return end
    local existing = 0
    for _, child in ipairs(orb:GetChildren()) do
        if child:IsA("ParticleEmitter") and child.Name == "BladeBallOrbParticles" then existing = existing + 1 end
    end
    if existing > 0 then return end

    createInstance("ParticleEmitter", orb, {
        Name = "BladeBallOrbParticles",
        Texture = CONFIG.particleTexture,
        Color = ColorSequence.new(CONFIG.orbParticleColor),
        Size = NumberSequence.new(CONFIG.orbParticleSize),
        Lifetime = NumberSequence.new(0.8),
        Rate = CONFIG.orbParticleRate,
        Speed = NumberRange.new(1, 3),
        SpreadAngle = Vector2.new(180, 180),
        LightEmission = 1,
        LightInfluence = 0,
        Transparency = NumberSequence.new({
            NumberSequenceKeypoint.new(0, 0),
            NumberSequenceKeypoint.new(0.6, 0.4),
            NumberSequenceKeypoint.new(1, 1),
        }),
    })
end

local function setupCharacterParticles()
    for _, player in ipairs(Players:GetPlayers()) do
        local char = player.Character
        if char then addParticlesToCharacter(char) end
        trackConnection(player.CharacterAdded:Connect(function(newChar)
            task.wait(0.1)
            addParticlesToCharacter(newChar)
        end))
    end
    trackConnection(Players.PlayerAdded:Connect(function(player)
        trackConnection(player.CharacterAdded:Connect(function(newChar)
            task.wait(0.1)
            addParticlesToCharacter(newChar)
        end))
    end))
end

local function setupOrbParticles()
    for _, desc in ipairs(Workspace:GetDescendants()) do
        if desc:IsA("BasePart") and (desc.Name:lower():find("orb") or desc.Name:lower():find("ball")) then
            if desc.Material == Enum.Material.Neon or desc:FindFirstChildOfClass("PointLight") then
                addOrbParticles(desc)
            end
        end
    end
    trackConnection(Workspace.DescendantAdded:Connect(function(desc)
        if desc:IsA("BasePart") and (desc.Name:lower():find("orb") or desc.Name:lower():find("ball")) then
            task.wait(0.1)
            if desc.Parent then addOrbParticles(desc) end
        end
    end))
end

local function setupTrailTracking()
    local function createTrailPart()
        local part = Instance.new("Part")
        part.Size = Vector3.new(0.1, 0.1, 0.1)
        part.Transparency = 1
        part.Anchored = true
        part.CanCollide = false
        part.CanQuery = false
        part.CanTouch = false
        part.Parent = Workspace
        table.insert(createdInstances, part)

        local a0 = Instance.new("Attachment"); a0.Parent = part
        local a1 = Instance.new("Attachment"); a1.Parent = part

        local tr = Instance.new("Trail")
        tr.Attachment0 = a0
        tr.Attachment1 = a1
        tr.Color = ColorSequence.new(CONFIG.trailColor)
        tr.Transparency = CONFIG.trailTransparency
        tr.Lifetime = CONFIG.trailLifetime
        tr.MinLength = 0.1
        tr.MaxLength = 3
        tr.LightEmission = 1
        tr.LightInfluence = 0
        tr.WidthScale = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(1, 0) })
        tr.Parent = part
        table.insert(createdInstances, tr)
        return part, tr
    end

    local function trackCharacter(character)
        local hrp = character:FindFirstChild("HumanoidRootPart")
        if not hrp then return end
        local lastPos = hrp.Position

        trackConnection(RunService.Heartbeat:Connect(function()
            local currentPos = hrp.Position
            if (currentPos - lastPos).Magnitude > 0.8 then
                local part, tr = createTrailPart()
                part.Position = currentPos
                task.delay(CONFIG.trailLifetime + 0.1, function()
                    if part then
                        tr.Enabled = false
                        task.delay(0.5, function() pcall(function() part:Destroy() end) end)
                    end
                end)
            end
            lastPos = currentPos
        end))
    end

    for _, player in ipairs(Players:GetPlayers()) do
        if player.Character then trackCharacter(player.Character) end
        trackConnection(player.CharacterAdded:Connect(function(newChar)
            task.wait(0.1)
            trackCharacter(newChar)
        end))
    end
end

local function tuneMaterials()
    local ok = pcall(function()
        for _, desc in ipairs(Workspace:GetDescendants()) do
            if desc:IsA("BasePart") and desc.Material == Enum.Material.Neon then
                local c = desc.Color
                desc.Color = Color3.new(
                    math.min(c.R * CONFIG.neonBoostMultiplier, 1),
                    math.min(c.G * CONFIG.neonBoostMultiplier, 1),
                    math.min(c.B * CONFIG.neonBoostMultiplier, 1)
                )
            end
        end
    end)
    
    if ok then
        local terrain = Workspace:FindFirstChildOfClass("Terrain")
        if terrain then
            pcall(function() terrain.WaterColor = CONFIG.terrainWaterColor end)
            pcall(function() terrain.WaterWaveSize = CONFIG.terrainWaterWaveSize end)
            pcall(function() terrain.WaterWaveSpeed = CONFIG.terrainWaterWaveSpeed end)
            pcall(function() terrain.WaterTransparency = CONFIG.terrainWaterTransparency end)
        end
    end
end

