    end)

    makeDraggable(mainFrame, titleBar)

    return screenGui, mainFrame
end

-- ============================================================
-- ENABLE / DISABLE
-- ============================================================
local uiRef = nil

local function enable()
    if isEnabled then return end
    isEnabled = true

    local atmos, sky = applyLighting()
    local bloom, cc, sunRays, dof, blur = applyPostProcessing()
    local gui, vignette, chroma = createScreenOverlay()

    setupCharacterParticles()
    setupOrbParticles()
    setupTrailTracking()
    tuneMaterials()
    setupParryBlur(blur)
    startAnimationLoop(atmos, bloom, vignette, chroma)

    if not uiRef then
        uiRef = createUI()
    else
        uiRef.Visible = true
    end
end

local function disable()
    if not isEnabled then return end
    isEnabled = false

    for _, conn in ipairs(connections) do pcall(function() conn:Disconnect() end) end
    connections = {}

    for instance, props in pairs(originals) do
        for prop, value in pairs(props) do safeSet(instance, prop, value) end
    end
    originals = {}

    for _, inst in ipairs(createdInstances) do pcall(function() inst:Destroy() end) end
    createdInstances = {}

    if uiRef then uiRef.Visible = false end
end

