-- ============================================================
-- UTILITY
-- ============================================================
local function safeSet(instance, property, value)
    pcall(function() instance[property] = value end)
end

local function storeOriginal(instance, property)
    local key = instance
    if not originals[key] then originals[key] = {} end
    if originals[key][property] == nil then originals[key][property] = instance[property] end
end

local function createInstance(className, parent, properties)
    local inst = Instance.new(className)
    for k, v in pairs(properties or {}) do safeSet(inst, k, v) end
    inst.Parent = parent
    table.insert(createdInstances, inst)
    return inst
end

local function trackConnection(conn)
    table.insert(connections, conn)
end

-- Helper: Replace JSON with Custom Serialization
local function serializeConfig(tbl)
    local str = "{\n"
    for k, v in pairs(tbl) do
        if type(v) == "number" then
            str = str .. string.format('    "%s": %s,\n', k, v)
        elseif type(v) == "boolean" then
            str = str .. string.format('    "%s": %s,\n', k, tostring(v))
        elseif type(v) == "string" then
            str = str .. string.format('    "%s": "%s",\n', k, v)
        end
    end
    str = str .. "}"
    return str
end

local function deserializeConfig(str)
    local success, parsed = pcall(function()
        local result = {}
        for k, v in string.gmatch(str, '"(%w+)":%s*([^,\n]+)') do
            local num = tonumber(v)
            if num then
                result[k] = num
            elseif v == "true" then
                result[k] = true
            elseif v == "false" then
                result[k] = false
            else
                result[k] = v:gsub("^%s*\"*", ""):gsub("\"*%s*$", "")
            end
        end
        return result
    end)
    if success then return parsed end
    return nil
end

